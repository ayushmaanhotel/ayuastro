generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  phone        String?  @unique
  passwordHash String? // For email/phone auth
  googleId     String?  @unique
  appleId      String?  @unique
  avatar       String?
  isOnboarded  Boolean  @default(false)
  hasPaid      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          Profile?
  preferences      UserPreferences?
  astrology        AstrologyData?
  numerology       NumerologyData?
  traits           TraitScores?
  reports          Report[]
  answers          QuestionnaireAnswer[]
  transactions     Transaction[]
  moodEntries      MoodEntry[]
  gratitudeEntries GratitudeEntry[]
  whatsappUsers    WhatsappUser[]
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  language             String   @default("en") // en, hi, hinglish
  darkMode             Boolean  @default(false)
  dailyHoroscope       Boolean  @default(true)
  moodReminders        Boolean  @default(true)
  vedicLevel           String   @default("standard") // standard, detailed, hinglish
  notificationsEnabled Boolean  @default(true)
  ucpEnabled           Boolean  @default(false)
  ucpToken             String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  dateOfBirth        String
  timeOfBirth        String
  placeOfBirth       String
  latitude           Float?
  longitude          Float?
  timezone           String?
  gender             String?
  relationshipStatus String?
  occupation         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AstrologyData {
  id                 String   @id @default(cuid())
  userId             String   @unique
  sunSign            String
  moonSign           String
  ascendant          String
  planetaryPositions String // JSON string
  houses             String // JSON string
  nakshatra          String // JSON string
  dashaPeriods       String // JSON string
  yogas              String // JSON string
  doshas             String // JSON string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NumerologyData {
  id                String   @id @default(cuid())
  userId            String   @unique
  lifePathNumber    Int
  destinyNumber     Int
  soulUrgeNumber    Int
  personalityNumber Int
  birthdayNumber    Int
  lifePathDesc      String?
  destinyDesc       String?
  soulUrgeDesc      String?
  personalityDesc   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TraitScores {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emotionalIntensity    Int // 0-100
  attachmentStyle       Int // 0-100 (0=secure, 100=anxious)
  ambition              Int
  trust                 Int
  communicationOpenness Int
  impulsiveness         Int
  empathy               Int
  resilience            Int
  creativity            Int
  intuition             Int
  discipline            Int
  socialEnergy          Int
  patience              Int
  adaptability          Int
  additionalTraits      String? // JSON string for future traits
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  type      String // personality, relationship, emotional_pattern
  title     String
  summary   String
  sections  String // JSON string with full report sections
  isPremium Boolean  @default(false)
  isPaid    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuestionnaireAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  answer     String
  category   String // emotional, social, behavioral, relational
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  amount            Int // in paise (Indian currency)
  currency          String   @default("INR")
  razorpayOrderId   String?
  razorpayPaymentId String?
  transactionId     String? // UTR / Transaction reference number from user
  paymentMethod     String? // upi, bank_transfer, other
  screenshotUrl     String? // optional screenshot reference
  status            String   @default("pending") // pending, completed, failed, refunded
  reportType        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      Int // 1-5 scale (1=very low, 5=excellent)
  emoji     String // Emoji representation
  note      String? // Optional journal note
  tags      String   @default("[]") // JSON array of tags like ["grateful", "anxious", "peaceful"]
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model GratitudeEntry {
  id        String   @id @default(uuid())
  userId    String
  slot      String // morning, afternoon, evening
  content   String // max 500 chars
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WhatsappUser {
  id             String    @id @default(cuid())
  appUserId      String?
  phoneNumber    String    @unique
  displayName    String?
  profileName    String?
  waId           String?   @unique
  isBlocked      Boolean   @default(false)
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appUser       User?                  @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  conversations WhatsappConversation[]
  messages      WhatsappMessage[]
  consents      WhatsappConsent[]
  jobs          WhatsappJob[]

  @@index([appUserId])
  @@index([phoneNumber])
}

model WhatsappConversation {
  id            String    @id @default(cuid())
  userId        String
  state         String    @default("open") // open, waiting_for_user, waiting_for_agent, closed, archived
  topic         String?
  context       String? // JSON string for conversation state/context
  startedAt     DateTime  @default(now())
  lastMessageAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     WhatsappUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]
  jobs     WhatsappJob[]

  @@index([userId, state])
  @@index([lastMessageAt])
}

model WhatsappMessage {
  id                String    @id @default(cuid())
  userId            String
  conversationId    String?
  direction         String // incoming, outgoing
  status            String    @default("received") // received, queued, sent, delivered, read, failed
  fromNumber        String
  toNumber          String
  whatsappMessageId String?   @unique
  messageType       String    @default("text") // text, image, audio, video, document, interactive, template, unknown
  body              String?
  mediaUrl          String?
  rawPayload        String? // JSON string from webhook/provider
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         WhatsappUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([direction, status])
  @@index([fromNumber])
  @@index([toNumber])
}

model WhatsappConsent {
  id          String    @id @default(cuid())
  userId      String
  status      String    @default("unknown") // unknown, opted_in, opted_out
  source      String? // inbound_message, website, admin, import, api
  reason      String?
  consentedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user WhatsappUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
}

model WhatsappJob {
  id             String    @id @default(cuid())
  userId         String?
  conversationId String?
  type           String // send_message, send_template, sync_status, process_inbound
  status         String    @default("pending") // pending, processing, completed, failed, cancelled
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  payload        String // JSON string
  result         String? // JSON string
  errorMessage   String?
  scheduledAt    DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         WhatsappUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation WhatsappConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([userId])
  @@index([conversationId])
}
